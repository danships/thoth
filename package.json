{
  "name": "thoth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "concurrently \"pnpm:lint:*\"",
    "lint:eslint": "eslint --ext .ts,.tsx",
    "lint:prettier": "prettier --check --log-level=warn src",
    "format": "prettier --write src && eslint --ext=js,jsx,ts,tsx --fix src",
    "lint:tsc": "tsc --noEmit",
    "better-auth:generate": "npx @better-auth/cli generate --config ./src/lib/auth/better-auth.ts --output schema.sql",
    "scripts:clear-auth": "tsx scripts/clear-auth.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@mantine/core": "^9.4.1",
    "@mantine/form": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/modals": "^9.4.1",
    "@mantine/notifications": "^9.4.1",
    "@nanostores/react": "^1.1.0",
    "@tabler/icons-react": "^3.44.0",
    "axios": "^1.18.1",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "mantine-form-zod-resolver": "^1.3.0",
    "mysql2": "^3.22.5",
    "nanostores": "^1.4.0",
    "next": "^16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "supersave": "1.0.0-beta4",
    "swr": "^2.4.2",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.2.10",
    "@tsconfig/strictest": "^2.0.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "@playwright/test": "^1.53.0",
    "tsx": "^4.19.4"
  },
  "packageManager": "pnpm@11.13.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "postcss": ">=8.5.10",
      "short-uuid": "^6.0.3"
    }
  }
}
