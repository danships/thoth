{
  "name": "thoth",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @thoth/web dev",
    "build": "pnpm --filter @thoth/web build",
    "start": "pnpm --filter @thoth/web start",
    "lint": "concurrently \"pnpm:lint:*\"",
    "lint:eslint": "eslint scripts",
    "lint:tsc": "tsc --noEmit",
    "lint:prettier": "prettier --check --log-level=warn scripts",
    "lint:openapi": "pnpm --filter @thoth/web lint:openapi",
    "lint:web": "pnpm --filter @thoth/web lint",
    "format": "prettier --write scripts && eslint --fix scripts",
    "openapi:generate": "pnpm --filter @thoth/web openapi:generate",
    "better-auth:generate": "pnpm --filter @thoth/web better-auth:generate",
    "scripts:clear-auth": "pnpm --filter @thoth/web scripts:clear-auth",
    "workspaces:purge": "tsx scripts/purge-deleted-workspaces.ts",
    "pages:purge": "tsx scripts/purge-deleted-pages.ts",
    "files:purge": "tsx scripts/purge-deleted-files.ts",
    "test": "pnpm --filter @thoth/web test",
    "test:unit": "pnpm --filter @thoth/web test:unit",
    "test:unit:watch": "pnpm --filter @thoth/web test:unit:watch",
    "test:integration": "pnpm --filter @thoth/web test:integration",
    "test:e2e": "pnpm --filter @thoth/web test:e2e",
    "test:e2e:ui": "pnpm --filter @thoth/web test:e2e:ui",
    "test:e2e:report": "pnpm --filter @thoth/web test:e2e:report",
    "db:seed": "pnpm --filter @thoth/web db:seed"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.1.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "packageManager": "pnpm@11.18.0"
}
