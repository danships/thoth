    "winston": "^3.19.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.1.0",
    "@types/web-push": "^3.6.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.4",
