NODE_ENV=test
DB=sqlite:///tmp/thoth-e2e.db
BETTER_AUTH_SECRET=test-better-auth-secret-for-e2e-local
LOG_LEVEL=error
PLAYWRIGHT_BASE_URL=http://localhost:3000
STORAGE_LOCAL_FOLDER=/tmp/thoth-e2e-uploads
# Fixed (rather than the harness's normal ephemeral tmp) so `page-history.spec.ts` can enqueue
# `history.maintain` directly against the same running jobs process the dev harness starts
# (THOTH-062, see `scripts/dev.mjs`'s `JOB_SOCKET_PATH` handling).
JOB_SOCKET_PATH=/tmp/thoth-e2e-jobs.sock
# Keep the intentionally unreachable webhook endpoint used by the E2E lifecycle test fast:
# delivery retries must reach a terminal state within the test's polling window.
WEBHOOK_DELIVERY_TIMEOUT_MS=300
WEBHOOK_DELIVERY_BACKOFF_BASE_MS=50
