# Example environment configuration for Thoth (THOTH-060).
#
# Copy this file to `.env` (or `apps/web/.env.local` for the web app specifically) and adjust
# as needed. See the "Environment variables" and "Process topology (PM2, web + jobs)" sections
# of the root README for the full, authoritative reference — every variable below is optional
# unless noted, and every non-mandatory one already has a safe default in code.

# --- apps/web (required) ---
NODE_ENV=development
DB=sqlite://./data/thoth.db
BETTER_AUTH_SECRET=change-me-to-a-strong-unique-secret

# --- apps/web (optional) ---
# LOG_LEVEL=info
# APP_URL=http://localhost:3000
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL=
# OIDC_AUTHORIZATION_URL=
# WORKSPACE_DELETE_GRACE_PERIOD_DAYS=30
# PAGE_DELETE_GRACE_PERIOD_DAYS=30
# STORAGE_TYPE=local
# STORAGE_LOCAL_FOLDER=data/uploads
# MAX_UPLOAD_SIZE_BYTES=10485760
# FILES_PURGE_GRACE_PERIOD_HOURS=24

# --- @thoth/jobs + shared jobs socket (all optional, safe defaults) ---
# Absolute path to the Unix domain socket @thoth/jobs listens on. Must be set to the SAME value
# for both the jobs process and apps/web (web only reads it for the /api/health ping — see
# apps/web/src/lib/jobs/health.ts). Defaults to a per-UID private temp path if unset.
# JOB_SOCKET_PATH=/tmp/thoth-jobs.sock
# JOB_POLL_INTERVAL_MS=1000
# JOB_SHUTDOWN_TIMEOUT_MS=10000
# JOB_CONCURRENCY=4
# JOB_RETENTION_MS=900000
# JOB_RETENTION_MAX=500
# JOB_SCHEDULER_TICK_MS=5000
# `@thoth/jobs` also needs a `DB` connection string of its own (THOTH-061) — the same value as
# apps/web's `DB` above works for a single-SQLite-file deployment. Both processes open the same
# database with schema sync/migrations disabled at runtime (see pm2.config.js).
# Outbound webhook delivery (THOTH-061) — network timeout per attempt and the base delay for
# full-jitter exponential backoff between retries. Safe production defaults; lowering these is
# only useful to speed up tests against unreachable URLs.
# WEBHOOK_DELIVERY_TIMEOUT_MS=5000
# WEBHOOK_DELIVERY_BACKOFF_BASE_MS=500

# --- @thoth/jobs maintenance schedules (THOTH-063, all optional, safe defaults) ---
# `@thoth/jobs` also needs its own `STORAGE_TYPE`/`STORAGE_LOCAL_FOLDER` (same semantics/values
# as apps/web's, above) so the `maintenance.purge-files` handler can delete orphaned upload
# bytes through the same storage adapter the web app uses.
# STORAGE_TYPE=local
# STORAGE_LOCAL_FOLDER=data/uploads
# Batch size used by every maintenance handler (and the manual `*:purge` CLI wrappers) per bounded
# execution/continuation step.
# MAINTENANCE_PURGE_BATCH_SIZE=100
# Terminal job-queue retention (see `apps/jobs/src/handlers/maintenance/prune-jobs.ts`): how long
# `completed`/`dead` in-memory job records are kept before `maintenance.prune-jobs` deletes them
# from the queue. These records are never persisted to a database table — the queue is fully
# in-memory and per-process (`apps/jobs/src/queue/queue-store.ts`), so this retention only bounds
# process memory. Queued/running jobs, terminal parents with active children, and rows still
# inside a retry/idempotency horizon are never pruned regardless of these values.
# JOB_COMPLETED_RETENTION_DAYS=7
# JOB_DEAD_RETENTION_DAYS=30
