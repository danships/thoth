{
  "name": "notion-import",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone Notion → Thoth import script (THOTH-049). Not part of the Thoth application/workspace — has its own dependencies, TypeScript config, and test runner.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx cli.ts",
