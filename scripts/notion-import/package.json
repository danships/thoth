  "dependencies": {
    "@notionhq/client": "^5.23.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.1.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
