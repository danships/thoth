# Increase pnpm's network resiliency for CI/Docker build environments where
# the npm registry can be flaky, causing tarball downloads to time out
# (observed as "TimeoutError: The operation was aborted due to timeout"
# during `pnpm install --frozen-lockfile` in the preview build).
fetch-timeout=300000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
network-concurrency=8
