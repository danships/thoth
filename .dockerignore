docs
apps/web/tests/*
# `apps/web/scripts/end-to-end-seed.ts` (type-checked as part of `pnpm build`, though
# only ever executed locally/in CI via Playwright's global setup) imports
# `apps/web/tests/e2e/constants.ts` and `apps/web/tests/fixtures/seed.ts`. Keep these files so
# the Docker build's TypeScript check can resolve those imports.
!apps/web/tests/e2e/constants.ts
!apps/web/tests/fixtures/seed.ts
# Co-located unit tests under `apps/web/src` (e.g. `src/lib/database/page-query-service.test.ts`)
# are part of the same TypeScript check and import this self-contained helper.
!apps/web/tests/helpers/create-test-database.ts
